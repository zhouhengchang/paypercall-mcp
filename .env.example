# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 只填你实际拥有的，留空则网关自动降级（无上游 key 时 llm.chat 走本地兜底/返回未配置）

# ---------- 上游模型（成本项，用于成本路由）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DOUBAO_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# ---------- 网关自身 ----------
PPC_PORT=8300
PPC_PUBLIC_BASE_URL=https://your-domain.example.com
# 后台令牌，至少 24 位，生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
PPC_ADMIN_TOKEN=

# ---------- x402 链上按次收款 ----------
PPC_X402_PAY_TO=
PPC_X402_FACILITATOR=https://x402.org/facilitator

# ---------- 平台订单回调验签 ----------
PPC_WEBHOOK_SECRET_COZE=
PPC_WEBHOOK_SECRET_WEIXIN=
PPC_WEBHOOK_SECRET_ALIPAY=

# ---------- 支付宝（当面付）----------
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
