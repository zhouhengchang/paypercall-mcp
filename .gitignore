# 运行时数据：含 API Key、后台令牌、数据库，绝不入库
data/
*.db
*.db-shm
*.db-wal
*.log

# 凭据
.env
.env.*
!.env.example
*.pem
*.key
*-bootstrap.txt

# 打包产物
release/*.tgz
release/*.zip

# 依赖与缓存
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store

# 编辑器
.vscode/
.idea/

# 收款码：含实名与收款信息，不进公开仓库
web/assets/pay-*.jpg
web/assets/pay-*.png

# 构建产物：由 scripts/build_product.py 生成，不入库
products/
